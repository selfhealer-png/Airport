{
  "name": "airfield",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An inverted tower defence game: build an airport so planes can land.",
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "vite-node scripts/gen-icons.ts",
    "day": "vite-node scripts/run-day.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
